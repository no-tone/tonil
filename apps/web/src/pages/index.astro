---
// biome-ignore-all lint/correctness/noUnusedImports: used in the template
// below the frontmatter fence, which Biome's Astro support doesn't analyze.
// biome-ignore-all lint/correctness/noUnusedVariables: ditto.
import T from "@repo/ui/site/T.astro";
import { INTRO } from "../copy/intro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="home · no-tone"
  description="Software engineer. Web applications end to end - front-end, API, and the infrastructure under them."
  section="intro"
  ramp="moss"
>
  <h1 class="site__title">
    <T en="Hi, I'm no-tone." pt="Olá, sou o no-tone." />
  </h1>

  <div class="site__body">
    {INTRO.map((p) => <T as="p" en={p.en} pt={p.pt} />)}

    <!--
      Split rather than one <T>: the swap replaces textContent, so anything
      with markup inside it has to be assembled from separate pieces. The
      {" "} are load-bearing - JSX drops whitespace that spans a newline,
      and without them the words run together.
    -->
    <p>
      <T
        en="If you want to talk about any of that, the address is at the bottom of this page."
        pt="Se quiseres falar sobre alguma destas coisas, o endereço está no fim desta página."
      />
    </p>
  </div>
</SiteLayout>
