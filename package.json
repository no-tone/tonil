{
  "name": "tonil",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "knip": "knip",
    "check-cycles": "madge --circular --extensions ts,tsx,astro apps packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.1.1",
    "knip": "^6.32.2",
    "madge": "^8.0.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "5.9.2",
      "vitest": "^4.1.10",
      "hono": "^4.12.32",
      "zod": "^4.4.3",
      "@hono/zod-validator": "^0.7.5",
      "astro": "^7.2.2",
      "@astrojs/cloudflare": "^14.2.1",
      "wrangler": "^4.123.0"
    }
  }
}
