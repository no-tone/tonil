---
// biome-ignore-all lint/correctness/noUnusedVariables: these are used in the
// template below the frontmatter fence, which Biome's Astro support doesn't analyze.
interface Props {
  siteName: string;
  siteUrl: string;
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  /**
   * The page's stylesheet, inlined into a nonce'd <style>.
   *
   * Note the trade-off, because the original reason given for this was
   * wrong: `style-src 'self' 'nonce-…'` allows a same-origin <link> just
   * fine, so the nonce is not what forces inlining. What inlining buys is
   * one fewer render-blocking request on a cold visit. What it costs is
   * caching — the CSS travels with every document, and with view
   * transitions each navigation fetches a document, so a visitor reading
   * three pages downloads it three times. At roughly 7KB gzipped that is a
   * fair trade for a site this size and a bad one as it grows.
   */
  css?: string;
  /** Override the viewport meta (e.g. to opt into safe-area insets). */
  viewport?: string;
  /** Discovery link for an RSS feed, if this app has one. */
  rssTitle?: string;
  /**
   * The theme this page is designed for. Required.
   *
   * Every page in this repo is dark-only, so this used to read a stored
   * preference and a visitor who had once chosen light got a dark-only
   * design rendered white-on-white. Rather than keep a branch that can only
   * produce that, the caller states what the page is and the answer is
   * written before first paint. Making it required is the point: a new page
   * cannot forget to decide.
   */
  theme: "dark" | "light";
  /**
   * The `robots` meta value.
   *
   * Defaults to indexable because most pages are. Private apps should say so
   * here rather than rely on robots.txt: `Disallow` stops crawling, not
   * indexing, so a blocked URL can still surface from an external link - and
   * a page that says `index,follow` while its robots.txt says `Disallow: /`
   * is telling two different stories.
   */
  robots?: string;
}

const {
  siteName,
  siteUrl,
  title,
  description,
  image = "/images/meta/og.png",
  schema,
  css,
  viewport = "width=device-width,initial-scale=1",
  rssTitle,
  theme,
  robots = "index,follow",
} = Astro.props as Props;
const styleCss = css ?? "";
const cspNonce = Astro.locals.cspNonce;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const ogImageUrl = new URL(image, Astro.url);
const canonicalHref = canonicalURL.toString();
const ogImageHref = ogImageUrl.toString();
const ogImageWidth = image === "/images/meta/og.png" ? "1200" : undefined;
const ogImageHeight = image === "/images/meta/og.png" ? "630" : undefined;
const schemaItems = Array.isArray(schema) ? schema : schema ? [schema] : [];
const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: "en",
  },
];
const resolvedSchema = [...defaultSchema, ...schemaItems];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content={viewport} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
<style nonce={cspNonce} set:html={styleCss}></style>

<script
  is:inline
  nonce={cspNonce}
  set:html={`document.documentElement.dataset.theme=${JSON.stringify(theme)}`}
/>

<link rel="canonical" href={canonicalHref} />
<link rel="alternate" hreflang="en" href={canonicalHref} />
<link rel="alternate" hreflang="x-default" href={canonicalHref} />

{rssTitle && (
  <link rel="alternate" type="application/rss+xml" title={rssTitle} href="/rss.xml" />
)}

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageHref} />
<meta property="og:image:secure_url" content={ogImageHref} />
{ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
{ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
<meta property="og:image:alt" content={`${siteName} preview`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalHref} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageHref} />
<meta name="twitter:image:alt" content={`${siteName} preview`} />

<script
  type="application/ld+json"
  is:inline
  nonce={cspNonce}
  set:html={JSON.stringify(resolvedSchema)}
/>
